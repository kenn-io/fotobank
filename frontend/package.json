{
  "name": "fotobank-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "vite",
    "build": "vite build --logLevel warn",
    "check:kit-ui": "kit-ui-check src --warn",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "bun run check && bunx tsc --noEmit -p ./tsconfig.json",
    "test": "vitest run",
    "build:e2e-server": "cd .. && make frontend && mkdir -p tmp && go build -tags sqlite_fts5 -o tmp/e2e-server ./cmd/e2e-server",
    "pretest:e2e": "bun run build:e2e-server",
    "pretest:e2e:sharing-disabled": "bun run build:e2e-server",
    "pretest:e2e:scale": "bun run build:e2e-server",
    "test:e2e": "playwright test --config=playwright-e2e.config.ts",
    "test:e2e:sharing-disabled": "playwright test --config=playwright-e2e-sharing-disabled.config.ts",
    "test:e2e:scale": "playwright test --config=playwright-e2e-scale.config.ts"
  },
  "dependencies": {
    "@kenn-io/kit-ui": "github:kenn-io/kit-ui#11c6ad385b82cea114df4e908e7914bbc4f26266",
    "leaflet": "1.9",
    "leaflet.markercluster": "1.5",
    "openapi-fetch": "^0.17.0",
    "panzoom": "^9.4.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.55.1",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "@testing-library/svelte": "5.2.8",
    "@tsconfig/svelte": "5.0.8",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.9.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.16.0",
    "globals": "^17.4.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "1.55.1",
    "prettier": "^3.8.1",
    "svelte": "5.55.10",
    "svelte-check": "4.4.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "8.0.16",
    "vitest": "3.2.4"
  }
}
